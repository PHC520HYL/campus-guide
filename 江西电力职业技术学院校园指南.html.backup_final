    { id:'caiwu', color:'bg-blue', accent:'blue', label:'财务缴费', tag:'学费与住宿', info:'缴费方式/时间', svg:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>' },
