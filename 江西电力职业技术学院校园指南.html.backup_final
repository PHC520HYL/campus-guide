var detailContent = {



jiaotong: '<div class="d-section"><div class="d-title">🚄 到校交通全攻略</div><div class="d-body">学校地址：江西省南昌市南昌经济技术开发区海棠南路<b>666号</b><br><br><b>🚉 南昌站（老火车站）</b><br>• 地铁2号线 → 地铁1号线 → 双港站 → 公交/打车<br>• 全程约60-80分钟，费用约15元<br><br><b>🚄 南昌西站（高铁站）</b><br>• 地铁2号线 → 地铁1号线 → 双港站<br>• 全程约50-70分钟，费用约12元<br><br><b>✈️ 昌北机场</b><br>• 机场大巴1线 → 地铁1号线 → 双港站<br>• 全程约90-120分钟，费用约25元<br><br><b>🚌 徐坊客运站</b><br>• 公交169路/227路直达学校附近<br>• 全程约40-60分钟，费用约4元<br><br>💡 <b>新生接站</b>：报到日当天学校会在南昌站、南昌西站设接站点，认准"江西电力职业技术学院"横幅！</div></div>',

bilei: '<div class="d-section"><div class="d-title">⚠️ 新生避雷指南</div><div class="d-body"><b>🔴 骗局一：冒充学长推销</b><br>• 特征：自称"学长学姐"，推销电话卡、英语报、被子等<br>• 套路：先套近乎，再推销高价低质商品<br>• 应对：学校<b>不会安排任何人进宿舍推销</b>，遇到直接拒绝并报告辅导员<br><br><b>🔴 骗局二：虚假兼职招聘</b><br>• 特征：QQ群/微信群发布"高薪兼职"，要求先交押金/培训费<br>• 套路：交完钱就拉黑，或安排根本不存在的工作<br>• 应对：任何要求<b>先交钱的兼职都是诈骗</b>！正规兼职通过学校勤工助学中心<br><br><b>🔴 骗局三：校园贷陷阱</b><br>• 特征：以"零利息""秒到账"为诱饵<br>• 套路：实际利率极高，还不上就威胁恐吓<br>• 应对：<b>绝对不要碰校园贷</b>！有困难找辅导员申请助学贷款<br><br>⚡ <b>紧急提醒</b>：所有收费项目以学校官方通知为准，任何个人收费都是骗子！</div></div>',

qingdan: '<div class="d-section"><div class="d-title">📝 新生必备清单</div><div class="d-body"><b>📋 证件类（必带！）</b><br>• 录取通知书原件<br>• 身份证原件及复印件（3份）<br>• 户口本本人页复印件<br>• 团员档案/党员档案<br>• 一寸/二寸证件照各8张（蓝底白底都要）<br>• 银行卡（用于缴纳学费）<br><br><b>🎒 生活用品</b><br>• 床上用品（被子、枕头、床单）<br>• 洗漱用品、毛巾、衣架<br>• 常用药品（感冒药、创可贴等）<br>• 充电宝、插线板<br>• 当季衣物（南昌夏热冬冷）<br><br><b>💻 学习用品</b><br>• 笔记本电脑（建议带，课程需要）<br>• 笔、笔记本、文件夹<br>• U盘<br><br>💡 <b>建议</b>：大件物品可以快递到学校，减轻行李负担！</div></div>',

xuefei: '<div class="d-section"><div class="d-title">💰 学费标准</div><div class="d-body"><b>📊 普通专业：5000元/年</b><br>• 电力系统自动化技术<br>• 供用电技术<br>• 发电厂及电力系统<br>• 输配电工程技术<br>• 热能动力工程技术<br>• 新能源装备技术<br>• 机电一体化技术<br>• 电气自动化技术<br>• 智能控制技术<br>• 工程造价<br>• 大数据技术<br>• 物联网应用技术<br>• 计算机应用技术<br>• 电子商务<br>• 现代物流管理<br><br><b>🌐 中外合作办学：12000元/年</b><br>• 电气自动化技术（中外合作）<br><br><b>🏠 住宿费</b><br>• 6人间：800元/年<br>• 4人间：1000元/年<br><br><b>📖 其他费用</b><br>• 教材费：约500-800元/年（多退少补）<br>• 军训服装费：约100元<br>• 体检费：约50元<br><br>💡 家庭经济困难学生可申请<b>生源地信用助学贷款</b>，最高12000元/年！</div></div>',

zhuanye: '<div class="d-section"><div class="d-title">🏫 专业介绍</div><div class="d-body"><b>⚡ 电力工程学院</b><br>• 电力系统自动化技术<br>• 供用电技术<br>• 发电厂及电力系统<br><br><b>🔌 供用电工程学院</b><br>• 供用电技术<br>• 输配电工程技术<br><br><b>🔥 动力工程学院</b><br>• 热能动力工程技术<br>• 新能源装备技术<br><br><b>🤖 电气工程学院</b><br>• 机电一体化技术<br>• 电气自动化技术<br>• 智能控制技术<br><br><b>💻 信息工程学院</b><br>• 大数据技术<br>• 物联网应用技术<br>• 计算机应用技术<br>• 电子商务<br>• 现代物流管理<br><br>💡 <b>王牌专业</b>：电力系统自动化技术、供用电技术是国家骨干专业，就业率高！</div></div>',

sushe: '<div class="d-section"><div class="d-title">🏠 宿舍介绍</div><div class="d-body"><b>👦 男生宿舍</b><br>• 6人间为主，上下铺<br>• 独立卫生间（部分楼栋）<br>• 空调：全覆盖，需租赁<br>• 热水：澡堂集中供应，刷卡计费<br>• 网络：校园网/WiFi，需办理<br><br><b>👧 女生宿舍</b><br>• 4-6人间，部分上床下桌<br>• 条件相对更好，空间更宽敞<br><br><b>📍 宿舍分布</b><br>• 1-5栋：男生宿舍区<br>• 6-8栋：女生宿舍区<br>• 快递点在10栋楼下<br><br><b>⚡ 用电限制</b><br>• 禁止使用大功率电器（电吹风、电热毯等）<br>• 违规会跳闸，严重者通报批评<br><br>💡 <b>建议</b>：报到当天早点去，可以选床位！</div></div>',



baodao: '<div class="d-section"><div class="d-title">📋 报到须知</div><div class="d-body"><b>📅 报到时间</b><br>• 2026年9月初（具体日期见录取通知书）<br>• 建议上午8:00-11:00到达，避开高峰<br><br><b>📍 报到地点</b><br>• 学校体育馆/操场（以通知为准）<br>• 各学院设有报到点，按专业找对应学院<br><br><b>📋 报到流程</b><br>1️⃣ 校门口出示录取通知书，领取报到流程单<br>2️⃣ 到所在学院报到点核验材料、领取宿舍钥匙<br>3️⃣ 缴纳学费/办理绿色通道<br>4️⃣ 领取校园卡、军训服装<br>5️⃣ 到宿舍办理入住<br><br><b>📄 必带材料</b><br>• 录取通知书、身份证、证件照<br>• 档案材料（团员/党员档案）<br>• 银行卡（缴费用）<br><br>💡 <b>绿色通道</b>：家庭经济困难学生可先办理入学手续，缓交学费！</div></div>',

card: '<div class="d-section"><div class="d-title">💳 校园卡绑定</div><div class="d-body"><b>📱 完美校园APP绑定</b><br><br><b>步骤一：下载APP</b><br>• 应用商店搜索"完美校园"下载<br>• 或扫描学校提供的二维码<br><br><b>步骤二：注册登录</b><br>• 用手机号注册<br>• 选择学校：江西电力职业技术学院<br><br><b>步骤三：绑定校园卡</b><br>• 输入学号+身份证后6位<br>• 或扫描校园卡背面条码<br><br><b>步骤四：充值</b><br>• 支持微信/支付宝充值<br>• 可用于食堂消费、澡堂刷卡、超市购物<br><br><b>💰 初始金额</b><br>• 校园卡预存100元（含在学费中）<br><br>💡 <b>丢失补办</b>：到一卡通中心补办，工本费15元</div></div>',

xueshengzheng: '<div class="d-section"><div class="d-title">🎫 学生证补办</div><div class="d-body"><b>📋 补办条件</b><br>• 学生证丢失或损坏<br>• 信息变更（如家庭住址）<br><br><b>🔄 补办流程</b><br>1️⃣ 到学工处领取《学生证补办申请表》<br>2️⃣ 填写个人信息，辅导员签字<br>3️⃣ 到财务处缴纳工本费<b>5元</b><br>4️⃣ 交回学工处，等待制证（约1周）<br><br><b>🚄 火车票优惠</b><br>• 学生证附有火车票优惠卡<br>• 每年可享4次半价硬座/高铁二等座<br>• 需到火车站窗口或自助机进行资质绑定<br><br><b>⚠️ 注意事项</b><br>• 优惠区间需填写正确（学校↔家庭住址）<br>• 每年需到学工处充值优惠次数<br><br>💡 <b>建议</b>：妥善保管学生证，补办期间无法购买学生票！</div></div>',

lvtong: '<div class="d-section"><div class="d-title">🌿 绿色通道</div><div class="d-body"><b>🎯 适用对象</b><br>• 家庭经济困难新生<br>• 已办理生源地助学贷款的学生<br>• 因特殊情况暂时无法缴纳学费的学生<br><br><b>🔄 办理流程</b><br>1️⃣ 报到当天到"绿色通道"窗口<br>2️⃣ 提交《家庭经济困难认定申请表》<br>3️⃣ 或出示生源地助学贷款受理证明<br>4️⃣ 办理缓交学费手续，先入学后缴费<br><br><b>💰 资助项目</b><br>• 生源地信用助学贷款：最高12000元/年<br>• 国家助学金：平均3300元/年<br>• 校内勤工助学：每月300-500元<br>• 临时困难补助：视情况发放<br><br><b>📞 咨询方式</b><br>• 学生资助管理中心<br>• 电话：见"常用电话"页面<br><br>💡 <b>承诺</b>：不让任何一名学生因家庭经济困难而失学！</div></div>',

dianhua: '<div class="d-section"><div class="d-title">📞 常用电话</div><div class="d-body"><b>🏫 学校部门</b><br>• 招生就业处：0791-XXXXXXX<br>• 学生工作处：0791-XXXXXXX<br>• 教务处：0791-XXXXXXX<br>• 后勤管理处：0791-XXXXXXX<br>• 保卫处：0791-XXXXXXX<br>• 校医院：0791-XXXXXXX<br>• 图书馆：0791-XXXXXXX<br><br><b>🆘 紧急电话</b><br>• 报警：110<br>• 急救：120<br>• 火警：119<br>• 学校保卫处：0791-XXXXXXX<br><br><b>💡 建议</b><br>• 将重要电话存入手机通讯录<br>• 关注学校官方微信公众号获取最新联系方式<br><br>⚠️ <b>【建议核对学校最新官方文件】</b>以上电话为示例，请以录取通知书或学校官网为准</div></div>',

junxun: '<div class="d-section"><div class="d-title">🎖️ 军训贴士</div><div class="d-body"><b>📅 军训时间</b><br>• 一般为开学后第2-3周开始<br>• 时长约2周<br><br><b>☀️ 防晒必备</b><br>• SPF50+防晒霜（每2小时补涂）<br>• 冰袖、遮阳帽<br>• 大容量水杯（1L以上）<br>• 藿香正气水（防中暑）<br><br><b>👟 装备建议</b><br>• 军训鞋垫（加厚，站军姿不累）<br>• 黑色袜子（要求统一）<br>• 皮带（军训裤腰大）<br><br><b>⏰ 作息安排</b><br>• 早操：6:30-7:00<br>• 上午训练：8:00-11:30<br>• 下午训练：14:30-17:30<br>• 晚上活动：19:00-21:00<br><br><b>🏥 免训申请</b><br>• 凭医院证明可申请免训或观训<br>• 到学工处办理手续<br><br>💡 <b>提醒</b>：军训有学分，无故缺席会影响毕业！</div></div>',



shitang: '<div class="d-section"><div class="d-title">🍚 食堂指南</div><div class="d-body"><b>📍 食堂位置</b><br>• 第一食堂：宿舍区附近<br>• 第二食堂：教学楼附近<br><br><b>💰 菜品价格</b><br>• 一荤一素：约9-11元<br>• 两荤一素：约12-15元<br>• 面食/米粉：约8-12元<br>• 早餐：约3-6元<br><br><b>⏰ 开放时间</b><br>• 早餐：6:30-9:00<br>• 午餐：11:00-13:00<br>• 晚餐：17:00-19:00<br><br><b>💳 支付方式</b><br>• 校园卡刷卡<br>• 完美校园APP扫码<br><br><b>🍱 周边美食</b><br>• 学校门口有小吃街<br>• 外卖可送到宿舍楼下<br><br>💡 <b>建议</b>：避开12:00和18:00高峰期，排队少！</div></div>',

kuaidi: '<div class="d-section"><div class="d-title">📦 快递收发</div><div class="d-body"><b>📍 快递点位置</b><br>• 学校快递驿站：10栋宿舍楼楼下<br>• 部分快递在西北门取件<br><br><b>📮 收件地址</b><br>• 完整地址：江西省南昌市南昌经济技术开发区海棠南路666号 江西电力职业技术学院<br>• 邮编：330013<br>• 收件人：姓名 + 手机号<br><br><b>📱 取件方式</b><br>• 短信/APP通知取件码<br>• 到快递驿站自助取件<br>• 大件快递可能需要人工领取<br><br><b>⏰ 开放时间</b><br>• 一般：9:00-20:00<br>• 高峰期（开学/双11）可能延长<br><br><b>📤 寄件</b><br>• 快递驿站支持寄件<br>• 价格与市面一致<br><br>💡 <b>建议</b>：开学季快递量大，建议提前3-5天寄出！</div></div>',

map: '<div class="d-section"><div class="d-title">🗺️ 校园地图</div><div class="d-body"><b>🏫 教学区</b><br>• 1号教学楼（主教学楼）<br>• 2-6号教学楼<br>• 实训楼（电力实训中心）<br>• 图书馆<br><br><b>🏠 生活区</b><br>• 1-8号宿舍楼<br>• 第一食堂、第二食堂<br>• 校园超市<br>• 澡堂/开水房<br><br><b>⚽ 运动区</b><br>• 田径场/足球场<br>• 篮球场（多个）<br>• 羽毛球场<br><br><b>🚪 校门</b><br>• 正门（南门）：海棠南路<br>• 西北门：快递取件点<br><br>💡 <b>建议</b>：报到当天领取校园地图手册，或在完美校园APP查看电子地图！</div></div>',

yishi: '<div class="d-section"><div class="d-title">🏥 校医室</div><div class="d-body"><b>📍 位置</b><br>• 学校医务室位于生活区附近<br>• 具体位置可咨询宿管或辅导员<br><br><b>⏰ 开放时间</b><br>• 工作日：8:00-17:30<br>• 夜间急诊：值班医生电话见公告<br><br><b>💊 服务内容</b><br>• 常见病诊疗<br>• 外伤处理<br>• 药品发放<br>• 体检组织<br><br><b>💳 医保报销</b><br>• 大学生医保可报销部分费用<br>• 保留好病历和发票<br>• 按学校规定时间统一报销<br><br>💡 <b>建议</b>：小病在校医室看，大病去附近医院（如南昌大学第一附属医院）！</div></div>',

chaoshi: '<div class="d-section"><div class="d-title">🏪 校园超市</div><div class="d-body"><b>📍 位置</b><br>• 第一超市：第一食堂旁边<br>• 第二超市：宿舍区中心位置<br><br><b>⏰ 营业时间</b><br>• 一般：7:00-22:00<br>• 周末可能延长<br><br><b>🛒 商品种类</b><br>• 零食饮料<br>• 生活用品（洗发水、纸巾等）<br>• 文具<br>• 水果<br><br><b>💰 价格</b><br>• 比校外超市略贵<br>• 支持校园卡/现金/微信支付<br><br>💡 <b>建议</b>：大件或批量购买建议网购或去校外超市更划算！</div></div>',

yundong: '<div class="d-section"><div class="d-title">⚽ 运动场所</div><div class="d-body"><b>🏃 田径场/足球场</b><br>• 标准400米跑道<br>• 足球场（天然草）<br>• 开放时间：6:00-22:00<br><br><b>🏀 篮球场</b><br>• 室外篮球场多个<br>• 晚上有灯光照明<br>• 高峰期需占场<br><br><b>🏸 羽毛球场</b><br>• 室内羽毛球馆<br>• 需预约或排队<br><br><b>🏓 其他设施</b><br>• 乒乓球台<br>• 单双杠等健身器材<br><br><b>💳 使用方式</b><br>• 大部分免费开放<br>• 部分场地需预约<br><br>💡 <b>建议</b>：晚上运动注意安全，建议结伴而行！</div></div>',

yushi: '<div class="d-section"><div class="d-title">🚿 浴室洗衣</div><div class="d-body"><b>🚿 澡堂</b><br>• 位置：宿舍区附近<br>• 开放时间：11:00-14:00, 16:00-22:00<br>• 计费方式：刷卡按流量计费，约2-5元/次<br>• 有隔间，隐私性好<br><br><b>🧺 洗衣房</b><br>• 每栋宿舍楼有公共洗衣房<br>• 洗衣机：3-4元/次<br>• 烘干机：2-3元/次<br>• 支持微信支付/校园卡<br><br><b>💧 开水房</b><br>• 每层楼有开水机<br>• 刷卡取水，约0.3元/壶<br><br>💡 <b>建议</b>：避开18:00-20:00高峰期，人少水热！</div></div>',

app: '<div class="d-section"><div class="d-title">📱 常用应用</div><div class="d-body"><b>💳 完美校园</b><br>• 校园卡充值/消费<br>• 课表查询<br>• 成绩查询<br>• <b>必备！</b><br><br><b>📚 学习通</b><br>• 线上课程学习<br>• 作业提交<br>• 考试签到<br>• <b>必备！</b><br><br><b>📋 教务系统</b><br>• 选课/退课<br>• 成绩查询<br>• 考试安排<br><br><b>📖 知网/万方</b><br>• 学术论文查阅<br>• 校园网IP免费下载<br><br><b>🚌 高德/百度地图</b><br>• 南昌出行导航<br>• 公交地铁查询<br><br>💡 <b>建议</b>：报到当天就把这些APP下载好！</div></div>',



xueshenghui: '<div class="d-section"><div class="d-title">👥 学生会</div><div class="d-body"><b>🏛️ 组织架构</b><br>学生会下设8大部门：<br><br><b>1️⃣ 办公室</b> — 统筹协调、文件管理<br><b>2️⃣ 学习部</b> — 学风建设、学术活动<br><b>3️⃣ 文艺部</b> — 文艺晚会、才艺比赛<br><b>4️⃣ 体育部</b> — 体育赛事、运动会<br><b>5️⃣ 宣传部</b> — 新媒体运营、海报设计<br><b>6️⃣ 外联部</b> — 赞助洽谈、校际交流<br><b>7️⃣ 生活部</b> — 宿舍检查、权益维护<br><b>8️⃣ 纪检部</b> — 纪律检查、考勤监督<br><br><b>🎯 加入好处</b><br>• 锻炼组织协调能力<br>• 加第二课堂学分<br>• 评优评先加分<br>• 拓展人脉<br><br><b>📅 招新时间</b><br>• 一般在军训结束后开始招新<br>• 关注食堂门口的招新摊位<br><br>💡 <b>建议</b>：选择1-2个感兴趣的部门，不要贪多！</div></div>',

shetuan: '<div class="d-section"><div class="d-title">🎭 社团组织</div><div class="d-body"><b>🎭 文艺类</b><br>• 合唱团、舞蹈队、话剧社<br>• 吉他社、街舞社、动漫社<br><br><b>⚽ 体育类</b><br>• 篮球社、足球社、羽毛球社<br>• 乒乓球社、轮滑社<br><br><b>💡 学术类</b><br>• 电子创新协会<br>• 计算机协会<br>• 英语角<br><br><b>❤️ 公益类</b><br>• 青年志愿者协会<br>• 红十字会<br><br><b>总计约27个社团</b><br><br><b>🎯 加入好处</b><br>• 发展兴趣爱好<br>• 加第二课堂学分<br>• 认识志同道合的朋友<br><br><b>📅 百团大战</b><br>• 每年10月左右举办社团招新活动<br>• 各社团在操场摆摊展示<br><br>💡 <b>建议</b>：先了解再报名，最多加入2-3个社团！</div></div>',

wanle: '<div class="d-section"><div class="d-title">🎉 娱乐活动</div><div class="d-body"><b>🎵 校园音乐节</b><br>• 每年举办1-2次<br>• 学生乐队/歌手表演<br>• 操场露天举行<br><br><b>🏀 篮球赛</b><br>• 新生杯篮球赛（开学后）<br>• 院系联赛<br>• 三人篮球赛<br><br><b>🎭 文艺晚会</b><br>• 迎新晚会（9月）<br>• 元旦晚会（12月）<br>• 毕业晚会（6月）<br><br><b>🎬 其他活动</b><br>• 电影放映周<br>• 校园歌手大赛<br>• 才艺展示大赛<br><br><b>🌆 周边娱乐</b><br>• 紫荆夜市（小吃街）<br>• 旭辉CMall（商场）<br>• 经开天虹（购物中心）<br>• 乐盈广场（美食娱乐）<br><br>💡 <b>建议</b>：关注学校公众号获取活动通知！</div></div>',

jidian: '<div class="d-section"><div class="d-title">📊 绩点学分</div><div class="d-body"><b>📈 绩点计算</b><br>• 60分=1.0绩点，70分=2.0绩点<br>• 80分=3.0绩点，90分=4.0绩点<br>• 100分=5.0绩点<br>• 公式：绩点 = (分数-50)/10<br><br><b>📚 学分要求</b><br>• 总学分：约130-150学分<br>• 必修课：约100学分<br>• 选修课：约20-30学分<br>• 第二课堂：约10学分<br><br><b>⚠️ 挂科影响</b><br>• 挂科需补考或重修<br>• 影响评优评先<br>• 影响奖学金评定<br>• 累计挂科过多可能影响毕业<br><br><b>🏆 优秀标准</b><br>• 平均绩点≥3.5：优秀<br>• 平均绩点≥3.0：良好<br>• 平均绩点≥2.0：及格<br><br>💡 <b>建议</b>：大一打好基础，绩点越高越好！</div></div>',

jiangzhu: '<div class="d-section"><div class="d-title">🏆 奖助学金</div><div class="d-body"><b>🏅 国家奖学金</b><br>• 金额：8000元/年<br>• 条件：成绩排名前10%，综合素质优秀<br><br><b>🥈 国家励志奖学金</b><br>• 金额：5000元/年<br>• 条件：成绩优秀+家庭经济困难<br><br><b>💰 国家助学金</b><br>• 金额：平均3300元/年（分档）<br>• 条件：家庭经济困难<br><br><b>🎓 校级奖学金</b><br>• 一等奖：2000元<br>• 二等奖：1000元<br>• 三等奖：500元<br><br><b>📅 评选时间</b><br>• 每年9-10月评选<br>• 需提交申请表和相关证明<br><br>💡 <b>建议</b>：保持好成绩+积极参与活动，奖学金机会更多！</div></div>',

lib: '<div class="d-section"><div class="d-title">📚 图书馆</div><div class="d-body"><b>📍 位置</b><br>• 学校图书馆位于教学区中心<br><br><b>⏰ 开放时间</b><br>• 周一至周五：8:00-22:00<br>• 周六日：9:00-21:00<br>• 节假日可能调整<br><br><b>📖 借阅规则</b><br>• 借阅数量：5-10本<br>• 借阅期限：30天<br>• 可续借1次（15天）<br>• 逾期罚款：0.1元/天<br><br><b>💺 自习座位</b><br>• 需预约（完美校园APP或现场扫码）<br>• 考研区/普通自习区<br>• 禁止占座<br><br><b>💻 电子资源</b><br>• 知网、万方免费下载<br>• 需连接校园网<br><br>💡 <b>建议</b>：期末考前早点去占座，人很多！</div></div>',

jiaoxue: '<div class="d-section"><div class="d-title">🏫 教学楼</div><div class="d-body"><b>📍 分布</b><br>• 1号教学楼：主教学楼，大部分课程<br>• 2-6号教学楼：各专业教室<br>• 实训楼：电力实训、实验课<br><br><b>🔍 找教室技巧</b><br>• 教室编号：楼号+楼层+房间号<br>• 例：1-301 = 1号楼3层301室<br>• 课表上有具体教室<br><br><b>⏰ 开放时间</b><br>• 一般：7:00-22:00<br>• 晚自习教室开放<br><br><b>⚡ 设施</b><br>• 多媒体教室（投影+电脑）<br>• 部分教室有空调<br>• 饮水机每层都有<br><br>💡 <b>建议</b>：提前10分钟到教室，避免迟到！</div></div>',

xuanke: '<div class="d-section"><div class="d-title">📋 选课重修</div><div class="d-body"><b>📅 选课时间</b><br>• 每学期末选下学期课程<br>• 具体时间关注教务通知<br><br><b>🔄 选课流程</b><br>1️⃣ 登录教务系统<br>2️⃣ 查看培养方案<br>3️⃣ 选择必修课+选修课<br>4️⃣ 确认提交<br><br><b>⚠️ 补考</b><br>• 挂科后下学期初补考<br>• 补考通过按60分计<br>• 补考不过需重修<br><br><b>🔄 重修</b><br>• 跟下一届重新上课<br>• 需缴纳重修费<br>• 影响毕业时间<br><br><b>🚨 学业预警</b><br>• 一学期挂科≥3门：黄色预警<br>• 累计挂科≥5门：橙色预警<br>• 累计挂科≥8门：红色预警（留级/退学风险）<br><br>💡 <b>建议</b>：必修课优先，选修课选感兴趣的！</div></div>',

zhuanben: '<div class="d-section"><div class="d-title">📈 专升本</div><div class="d-body"><b>📋 报考条件</b><br>• 应届专科毕业生<br>• 在校期间无处分记录<br>• 部分专业有对口要求<br><br><b>📅 考试时间</b><br>• 一般在大三下学期（3-4月）<br>• 具体以江西省教育考试院通知为准<br><br><b>📚 考试科目</b><br>• 公共课：英语+政治/计算机<br>• 专业课：根据报考专业定<br><br><b>🎯 可报考院校</b><br>• 江西省内本科院校<br>• 如：华东交通大学、南昌工程学院等<br><br><b>📖 备考建议</b><br>• 大二开始准备<br>• 报辅导班或自学<br>• 刷历年真题<br><br>💡 <b>提醒</b>：专升本只有一次机会（应届），务必重视！</div></div>',

zhengshu: '<div class="d-section"><div class="d-title">📜 技能证书</div><div class="d-body"><b>⚡ 电力类（必考）</b><br>• 电工证（低压/高压）<br>• 进网作业许可证<br><br><b>💻 计算机类</b><br>• 全国计算机等级考试（一级/二级）<br>• 建议考二级（C语言/Office）<br><br><b>🌐 英语类</b><br>• 英语四级（CET-4）<br>• 英语六级（CET-6）<br><br><b>📋 其他证书</b><br>• 普通话等级证书<br>• 驾驶证<br><br><b>📅 考试时间</b><br>• 计算机等级：3月/9月<br>• 英语四六级：6月/12月<br><br>💡 <b>建议</b>：电工证对电力专业就业很重要，尽早考取！</div></div>',

dierketang: '<div class="d-section"><div class="d-title">🎯 第二课堂</div><div class="d-body"><b>📋 学分要求</b><br>• 需修满约10学分<br>• 包含多个模块<br><br><b>📚 活动类型</b><br>• 思想成长（党团活动、讲座）<br>• 实践实习（社会实践、志愿服务）<br>• 创新创业（竞赛、项目）<br>• 文体活动（社团、比赛）<br>• 技能特长（培训、考证）<br><br><b>📱 记录方式</b><br>• 通过完美校园APP申报<br>• 参加活动后扫码签到<br>• 自动累计学分<br><br><b>⚠️ 注意</b><br>• 第二课堂学分不足影响毕业<br>• 建议从大一开始积累<br><br>💡 <b>建议</b>：多参加志愿活动和社团，既加学分又丰富经历！</div></div>',

jingsai: '<div class="d-section"><div class="d-title">🏆 科研竞赛</div><div class="d-body"><b>⚡ 电力类竞赛</b><br>• 全国职业院校技能大赛<br>• "挑战杯"大学生课外学术科技作品竞赛<br>• "互联网+"大学生创新创业大赛<br><br><b>💻 计算机类</b><br>• ACM程序设计竞赛<br>• 蓝桥杯<br>• 数学建模竞赛<br><br><b>🎯 参赛好处</b><br>• 加第二课堂学分<br>• 评优评先加分<br>• 获奖可保研/优先就业<br>• 简历亮点<br><br><b>📅 备赛时间</b><br>• 一般提前3-6个月准备<br>• 找指导老师组队<br><br>💡 <b>建议</b>：大一先了解，大二开始参赛！</div></div>',

shixi: '<div class="d-section"><div class="d-title">💼 实习就业</div><div class="d-body"><b>⚡ 主要去向</b><br>• 国家电网（各省电力公司）<br>• 南方电网<br>• 发电集团（华能、大唐等）<br>• 电力设计院/电建公司<br>• 新能源企业<br><br><b>📋 国家电网考试</b><br>• 每年12月（第一批）/次年3月（第二批）<br>• 笔试+面试<br>• 竞争激烈，需提前准备<br><br><b>🎯 实习安排</b><br>• 大三下学期顶岗实习<br>• 学校统一安排或自主联系<br>• 实习单位多为电力相关企业<br><br><b>📊 就业率</b><br>• 学校就业率保持在95%以上<br>• 电力类专业就业率接近100%<br><br>💡 <b>建议</b>：想进电网从大一开始准备，成绩+证书+竞赛都要抓！</div></div>',

dangtuan: '<div class="d-section"><div class="d-title">🚩 党团组织</div><div class="d-body"><b>👥 团员关系转接</b><br>• 开学后统一办理<br>• 需携带团员档案<br>• 在"智慧团建"系统操作<br><br><b>🎖️ 入党流程</b><br>1️⃣ 递交入党申请书<br>2️⃣ 确定为入党积极分子<br>3️⃣ 培养考察（至少1年）<br>4️⃣ 确定为发展对象<br>5️⃣ 预备党员<br>6️⃣ 转正<br><br><b>📅 入党时间</b><br>• 大一递交申请<br>• 大二成为积极分子<br>• 大三成为预备党员<br><br><b>🎯 入党好处</b><br>• 考公务员/事业单位有优势<br>• 国企招聘优先考虑<br>• 评优评先加分<br><br>💡 <b>建议</b>：有入党意向尽早递交申请，成绩和表现都要好！</div></div>',

pingyou: '<div class="d-section"><div class="d-title">🌟 评优评先</div><div class="d-body"><b>🏆 荣誉称号</b><br>• 三好学生<br>• 优秀学生干部<br>• 优秀团员/团干<br>• 优秀毕业生<br><br><b>📋 评选条件</b><br>• 成绩优良（绩点≥3.0）<br>• 无挂科记录<br>• 无违纪处分<br>• 积极参与活动<br><br><b>📅 评选时间</b><br>• 每学年评选一次<br>• 一般在9-10月<br><br><b>🎯 评选好处</b><br>• 奖学金优先<br>• 简历加分<br>• 就业推荐<br><br>💡 <b>建议</b>：保持好成绩+多参加活动+担任学生干部，评优机会更大！</div></div>',

qingong: '<div class="d-section"><div class="d-title">💪 勤工助学</div><div class="d-body"><b>📋 岗位类型</b><br>• 图书馆助理<br>• 食堂服务员<br>• 实验室助理<br>• 行政助理<br>• 校园巡逻<br><br><b>💰 待遇</b><br>• 每小时约12-15元<br>• 每月不超过40小时<br>• 月收入约300-500元<br><br><b>🔄 申请流程</b><br>1️⃣ 到学生资助管理中心申请<br>2️⃣ 填写申请表<br>3️⃣ 面试安排岗位<br>4️⃣ 签订合同上岗<br><br><b>⏰ 工作时间</b><br>• 课余时间<br>• 不耽误上课<br><br>💡 <b>建议</b>：既能赚钱又能锻炼能力，推荐申请！</div></div>',

jineng: '<div class="d-section"><div class="d-title">📚 技能提升</div><div class="d-body"><b>💻 在线学习平台</b><br>• 中国大学MOOC<br>• 学堂在线<br>• 智慧职教<br><br><b>⚡ 电力专业资源</b><br>• 电力实训平台<br>• 仿真实验系统<br>• 企业在线培训<br><br><b>📖 图书馆资源</b><br>• 知网/万方免费下载<br>• 电子图书<br>• 专业期刊<br><br><b>🎯 建议学习方向</b><br>• 编程：Python/C语言<br>• 设计：CAD/PS<br>• 办公：Excel高级应用<br><br>💡 <b>建议</b>：利用课余时间多学技能，就业更有竞争力！</div></div>',

qingjia: '<div class="d-section"><div class="d-title">📝 请假流程</div><div class="d-body"><b>📋 事假</b><br>• 1天以内：辅导员批准<br>• 1-3天：学院批准<br>• 3天以上：学校批准<br><br><b>🏥 病假</b><br>• 需提供医院证明<br>• 流程同事假<br><br><b>🔄 请假流程</b><br>1️⃣ 填写请假申请表<br>2️⃣ 辅导员签字<br>3️⃣ 学院审批<br>4️⃣ 销假（返校后）<br><br><b>⚠️ 注意</b><br>• 未经批准缺课视为旷课<br>• 累计旷课达到一定学时给予处分<br><br>💡 <b>建议</b>：提前请假，不要先斩后奏！</div></div>',

yibao: '<div class="d-section"><div class="d-title">🏥 医保报销</div><div class="d-body"><b>📋 参保对象</b><br>• 全体在校学生<br>• 每年统一参保<br><br><b>💰 缴费标准</b><br>• 约350元/年（以当年政策为准）<br><br><b>🏥 报销范围</b><br>• 门诊：校医室就诊可报销部分<br>• 住院：定点医院住院可报销<br>• 比例约50-70%<br><br><b>🔄 报销流程</b><br>1️⃣ 保留病历、发票、费用清单<br>2️⃣ 到校医院或学生处提交材料<br>3️⃣ 等待审核报销<br><br>💡 <b>建议</b>：看病保留好所有票据，否则无法报销！</div></div>',

baoxiu: '<div class="d-section"><div class="d-title">🔧 宿舍报修</div><div class="d-body"><b>📋 报修范围</b><br>• 水电故障<br>• 门窗损坏<br>• 家具损坏<br>• 网络故障<br><br><b>📱 报修方式</b><br>• 完美校园APP在线报修<br>• 宿管处登记<br>• 后勤管理处电话<br><br><b>⏰ 响应时间</b><br>• 紧急故障：24小时内<br>• 一般故障：3-5天<br><br><b>💰 费用</b><br>• 自然损坏：免费维修<br>• 人为损坏：需赔偿<br><br>💡 <b>建议</b>：发现问题及时报修，不要拖延！</div></div>',

xueji: '<div class="d-section"><div class="d-title">📋 学籍异动</div><div class="d-body"><b>🔄 休学</b><br>• 因病或其他原因需暂停学业<br>• 休学期限一般为1年<br>• 需办理休学手续<br><br><b>🔄 复学</b><br>• 休学期满后申请复学<br>• 到教务处办理手续<br><br><b>🔄 转学</b><br>• 需符合转学条件<br>• 两校同意后方可办理<br><br><b>🔄 退学</b><br>• 自愿退学或按规定退学<br>• 需办理退学手续<br><br>💡 <b>建议</b>：学籍异动影响毕业，慎重考虑！</div></div>',

caiwu: '<div class="d-section"><div class="d-title">💰 财务缴费</div><div class="d-body"><b>📋 缴费项目</b><br>• 学费：5000元/年（普通专业）<br>• 住宿费：800-1000元/年<br>• 教材费：约500-800元/年<br><br><b>💳 缴费方式</b><br>• 银行转账（学校指定账户）<br>• 现场刷卡<br>• 微信支付/支付宝<br><br><b>📅 缴费时间</b><br>• 每学年开学前<br>• 具体时间见学校通知<br><br><b>🧾 发票</b><br>• 缴费后可索取电子发票<br>• 用于生源地贷款回执<br><br>💡 <b>建议</b>：保留缴费凭证，以备查验！</div></div>',

baowei: '<div class="d-section"><div class="d-title">🛡️ 保卫处</div><div class="d-body"><b>📍 位置</b><br>• 学校保卫处位于校门附近<br><br><b>📞 联系方式</b><br>• 电话：见"常用电话"页面<br>• 24小时值班<br><br><b>🛡️ 主要职责</b><br>• 校园安全巡逻<br>• 门禁管理<br>• 失物招领<br>• 案件处理<br><br><b>🚪 门禁规定</b><br>• 晚归时间：23:00<br>• 晚归需登记<br>• 夜不归宿需请假<br><br><b>📋 失物招领</b><br>• 拾到物品交到保卫处<br>• 丢失物品到保卫处查询<br><br>💡 <b>建议</b>：遇到安全问题第一时间联系保卫处！</div></div>',

zizhu: '<div class="d-section"><div class="d-title">💝 学生资助</div><div class="d-body"><b>💰 生源地信用助学贷款</b><br>• 最高12000元/年<br>• 在校期间免息<br>• 毕业后开始还款<br><br><b>🔄 申请流程</b><br>1️⃣ 暑假到当地教育局申请<br>2️⃣ 提交材料（身份证、录取通知书等）<br>3️⃣ 签订贷款合同<br>4️⃣ 开学后交回执到学校<br><br><b>💰 国家助学金</b><br>• 平均3300元/年<br>• 分档发放<br><br><b>💪 勤工助学</b><br>• 校内岗位<br>• 每月300-500元<br><br>💡 <b>建议</b>：有困难及时申请，不要硬撑！</div></div>',

jiaowu: '<div class="d-section"><div class="d-title">💻 教务入口</div><div class="d-body"><b>🌐 教务系统</b><br>• 网址：见学校官网<br>• 功能：选课、查成绩、查课表<br><br><b>📱 完美校园APP</b><br>• 课表查询<br>• 成绩查询<br>• 考试安排<br><br><b>📋 常用功能</b><br>• 选课/退课<br>• 考试报名<br>• 成绩查询<br>• 学分统计<br><br>💡 <b>建议</b>：收藏教务系统网址，经常查看通知！</div></div>',



jiuxiao: '<div class="d-section"><div class="d-title">🚗 驾校推荐</div><div class="d-body"><b>🏫 校内合作驾校</b><br>• 学校周边有多家驾校<br>• 部分与学校有合作关系<br><br><b>💰 价格参考</b><br>• C1手动挡：约2800-3500元<br>• C2自动挡：约3200-4000元<br>• 学生价通常比社会价便宜300-500元<br><br><b>📅 拿证时间</b><br>• 顺利的话2-3个月<br>• 需合理安排练车时间<br><br><b>⚠️ 防骗提醒</b><br>• 选择有正规资质的驾校<br>• 签订正规合同<br>• 不要轻信"包过"承诺<br><br>💡 <b>建议</b>：大一大二考驾照，时间充裕！</div></div>',

taocan: '<div class="d-section"><div class="d-title">📱 电话卡套餐</div><div class="d-body"><b>📶 校园内运营商</b><br>• 中国移动：校内有实体营业厅<br>• 中国联通：信号覆盖<br>• 中国电信：信号覆盖<br><br><b>💳 移动校园套餐（推荐）</b><br>• 月租：约29-39元<br>• 流量：30-50GB（含校园流量）<br>• 通话：100-200分钟<br>• 赠送校园宽带<br><br><b>📍 办理地点</b><br>• 校内移动营业厅（具体位置咨询学长）<br>• 开学季有摆摊办理<br><br><b>⚠️ 防骗提醒</b><br>• 不要轻信上门推销的电话卡<br>• 到正规营业厅办理<br>• 仔细阅读套餐内容<br><br>💡 <b>建议</b>：对比三家运营商，选择信号好、套餐划算的！</div></div>',

zhusheng: '<div class="d-section"><div class="d-title">📚 升本辅导</div><div class="d-body"><b>📋 专升本考试</b><br>• 江西省统一组织<br>• 每年3-4月考试<br><br><b>📚 辅导资源</b><br>• 校内辅导班（如有）<br>• 校外培训机构<br>• 自学（网课+教材）<br><br><b>💰 费用参考</b><br>• 网课：几百到几千元<br>• 线下班：5000-15000元<br><br><b>⚠️ 选择建议</b><br>• 选择有口碑的机构<br>• 不要轻信"包过"承诺<br>• 试听后再决定<br><br>💡 <b>建议</b>：大二开始准备，时间充裕！</div></div>',

guowang: '<div class="d-section"><div class="d-title">⚡ 国网培训</div><div class="d-body"><b>📋 国家电网招聘考试</b><br>• 每年12月（第一批）/次年3月（第二批）<br>• 笔试+面试<br><br><b>📚 考试内容</b><br>• 公共部分：行测+企业文化<br>• 专业部分：电力系统/电路/电机等<br><br><b>📖 备考资源</b><br>• 官方教材<br>• 历年真题<br>• 培训班（线上/线下）<br><br><b>💰 培训费用</b><br>• 网课：2000-5000元<br>• 线下班：8000-20000元<br><br><b>⚠️ 选择建议</b><br>• 选择专门针对电网考试的机构<br>• 关注通过率<br><br>💡 <b>建议</b>：大三开始系统备考，不要临时抱佛脚！</div></div>',

jianzhi: '<div class="d-section"><div class="d-title">💼 兼职信息</div><div class="d-body"><b>🏫 校内兼职</b><br>• 勤工助学岗位（见"勤工助学"页面）<br>• 图书馆助理<br>• 食堂服务员<br><br><b>🌐 校外兼职</b><br>• 家教<br>• 促销员<br>• 服务员<br><br><b>⚠️ 防骗提醒</b><br>• 任何要求先交钱的兼职都是诈骗！<br>• 不要轻信"高薪轻松"的兼职<br>• 通过正规渠道找兼职<br><br><b>📋 正规渠道</b><br>• 学校勤工助学中心<br>• 正规招聘网站<br>• 学长学姐推荐<br><br>💡 <b>建议</b>：以学业为主，兼职不要影响学习！</div></div>',

paotui: '<div class="d-section"><div class="d-title">🛵 校园配送</div><div class="d-body"><b>🍱 外卖配送</b><br>• 美团/饿了么可送到校门口<br>• 部分可送到宿舍楼下<br><br><b>📦 快递代取</b><br>• 校内可能有代取服务<br>• 费用约1-2元/件<br><br><b>🛒 跑腿服务</b><br>• 代买生活用品<br>• 代打印资料<br><br><b>⚠️ 安全提醒</b><br>• 选择信誉好的平台/个人<br>• 贵重物品谨慎代取<br><br>💡 <b>建议</b>：天气不好或忙的时候可以用，平时自己取更省钱！</div></div>',

lingshi: '<div class="d-section"><div class="d-title">🍿 零食小铺</div><div class="d-body"><b>🏪 校内购买</b><br>• 校园超市<br>• 宿舍区小卖部<br><br><b>📱 线上购买</b><br>• 淘宝/京东/拼多多<br>• 快递到学校<br><br><b>🛵 零食配送</b><br>• 部分宿舍有零食配送群<br>• 送到寝室门口<br><br><b>💰 价格对比</b><br>• 校内超市略贵<br>• 网购更划算（批量购买）<br><br>💡 <b>建议</b>：和室友拼单网购，既省钱又热闹！</div></div>',



default: '<div class="d-section"><div class="d-title">📄 详情</div><div class="d-body">该内容正在整理中，敬请期待！<br><br>如有疑问，请联系学长咨询。</div></div>'

};

var allItems = [];
for (var k in gridData) { allItems = allItems.concat(gridData[k]); }

var stages = {
  departure: { emoji:'📦', title:'出发前准备', desc:'收到录取通知后，这些事情先搞定', items:['qingdan','jiaotong','xuefei','sushe','map','app'], chip:'出发前' },
  checkin:   { emoji:'🏁', title:'报到当天', desc:'顺利入学，按部就班不慌张', items:['baodao','card','lvtong','bilei','dianhua'], chip:'报到日' },
  term:      { emoji:'📚', title:'开学适应期', desc:'安顿好之后，了解这些让生活更顺畅', items:['shitang','junxun','kuaidi','chaoshi','yushi','yishi','yundong','sushe'], chip:'开学后' },
  daily:     { emoji:'🎓', title:'校园日常搜索', desc:'搜索或分类浏览全部校园指南', items:null, chip:'校园日常' },
  deals:     { emoji:'🛒', title:'校园特惠', desc:'学长精选福利，省钱省心一整年', items:null, chip:'校园特惠' }
};
var currentStage = 'departure';
var currentCatFilter = null;

function findItemById(id) {
  for (var i = 0; i < allItems.length; i++) { if (allItems[i].id === id) return allItems[i]; }
  return null;
}

function renderCard(item) {
  return '<div class="grid-item" data-id="'+item.id+'" data-accent="'+(item.accent||'blue')+'"><div class="grid-icon '+(item.color||'bg-blue')+'">'+item.svg+'</div><div class="grid-label">'+item.label+'</div><div class="grid-tag">'+(item.tag||item.desc||'')+'</div></div>';
}

function renderStageGrid() {
  var grid = document.getElementById('cardsGrid');
  var items;
  if (currentStage === 'deals') {
    items = gridData['deals'] || [];
  } else if (currentStage === 'daily') {
    items = currentCatFilter ? (gridData[currentCatFilter] || []) : allItems;
  } else {
    var ids = stages[currentStage].items;
    items = ids.map(function(id){return findItemById(id);}).filter(Boolean);
  }
  grid.innerHTML = items.map(renderCard).join('');
}

function renderDailyExtra() {
  var extra = document.getElementById('stageExtra');
  if (currentStage !== 'daily') { extra.innerHTML = ''; return; }
  var cats = [
    {id:'xinbi',label:'新生必读'},{id:'life',label:'校园生活'},{id:'study',label:'学业发展'},
    {id:'growth',label:'成长发展'},{id:'service',label:'办事指南'},{id:'deals',label:'🛒 校园特惠'}
  ];
  var chips = cats.map(function(c){
    return '<button class="cat-chip'+(currentCatFilter===c.id?' active':'')+'" data-cat="'+c.id+'">'+c.label+'</button>';
  }).join('');
  extra.innerHTML =
    '<div class="search-module">'+
      '<div class="search-module-title">🔍 校园资料搜索</div>'+
      '<div class="search-module-desc">输入关键词，查找校园指南</div>'+
      '<div class="search-row">'+
        '<label for="searchInput" class="sr-only">搜索校园指南</label>'+
        '<input class="search-input" id="searchInput" type="text" placeholder=“宿舍、食堂、学费、教务处…">'+
        '<button class="search-btn" id="searchBtn">搜索</button>'+
      '</div>'+
      '<div class="search-hints">'+
        '<span class="search-hint" data-kw=”快递“>快递</span>'+
        '<span class="search-hint" data-kw=”宿舍“>宿舍</span>'+
        '<span class="search-hint" data-kw=”学费“>学费</span>'+
        '<span class="search-hint" data-kw=”教务处“>教务处</span>'+
      '</div>'+
    '</div>'+
    '<div class="cat-bar" id="catChips">'+chips+'</div>';
}

function updateStageUI() {
  document.querySelectorAll('.timeline-item').forEach(function(el) {
    el.classList.toggle('active', el.getAttribute('data-stage') === currentStage);
  });
  var s = stages[currentStage];
  document.getElementById('stageHeader').innerHTML =
    '<span class="stage-emoji" style="display:inline-block;width:44px;height:44px;line-height:44px;text-align:center;background:var(--blue-50);border-radius:14px;font-size:22px;margin-bottom:10px;">'+s.emoji+'</span>'+
    '<span class="stage-chip">'+s.chip+'</span>'+
    '<h2>'+s.title+'</h2>';
  renderStageGrid();
  renderDailyExtra();
}

function setStage(stageId) {
  if (currentStage === stageId) return;
  currentStage = stageId;
  currentCatFilter = null;
  updateStageUI();
  document.getElementById('mainContent').scrollIntoView({behavior:'smooth',block:'start'});
  if (stageId === 'daily') bindSearchInline();
}

/* ============ DETAIL PAGE ============ */
function openDetail(id) {
  var page = document.getElementById('detailPage');
  var item = findItemById(id);
  document.getElementById('detailTitle').textContent = item ? (item.label || '详情') : '详情';
  document.getElementById('detailBody').innerHTML = detailContent[id] || detailContent['default'] || '';
  page.classList.add('active');
  document.body.classList.add('noscroll');
  page.scrollTop = 0;
}
function closeDetail() {
  document.getElementById('detailPage').classList.remove('active');
  document.body.classList.remove('noscroll');
}

/* ============ MODAL ============ */
var contactModal = document.getElementById('contactModal');
function openModal() { contactModal.classList.remove('hidden'); document.body.classList.add('noscroll'); }
function closeModal() { contactModal.classList.add('hidden'); document.body.classList.remove('noscroll'); }

/* ============ TOAST ============ */
var toastTimer;
function showToast(msg) {
  var t = document.getElementById('toast');
  t.textContent = msg; t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(function(){t.classList.remove('show');},2000);
}

/* ============ COPY ============ */
function copyText(text) {
  if (navigator.clipboard && navigator.clipboard.writeText) {
    navigator.clipboard.writeText(text).then(function(){showToast('✅ 已复制：'+text);}).catch(function(){fallbackCopy(text);});
  } else { fallbackCopy(text); }
}
function fallbackCopy(text) {
  var ta = document.createElement('textarea');
  ta.value = text; ta.style.position='fixed';ta.style.opacity='0';
  document.body.appendChild(ta);ta.select();
  try{document.execCommand('copy');showToast('✅ 已复制：'+text);}
  catch(e){showToast('复制失败，请长按手动复制');}
  document.body.removeChild(ta);
}

/* ============ SEARCH ============ */
function navigateToCard(id) {
  var foundStage = null;
  for (var s in stages) {
    if (stages[s].items && stages[s].items.indexOf(id) >= 0) {foundStage = s; break;}
  }
  if (foundStage) {currentStage = foundStage; currentCatFilter = null; updateStageUI();}
  setTimeout(function(){openDetail(id);},200);
}

function doSearch(q) {
  q = (q || (document.getElementById('searchInput')?document.getElementById('searchInput').value:'')).trim();
  if (!q) return;
  var map = {
    '快递':'kuaidi','宿舍':'sushe','学费':'xuefei','食堂':'shitang','交通':'jiaotong','避雷':'bilei',
    '骗':'bilei','推销':'bilei','学生会':'xueshenghui','社团':'shetuan','校医':'yishi',
    '学生证':'xueshengzheng','补办':'xueshengzheng','电话':'dianhua','地图':'map','报到':'baodao',
    '军训':'junxun','清单':'qingdan','绿色通道':'lvtong','困难':'lvtong','校园卡':'card','应用':'app',
    '超市':'chaoshi','浴室':'yushi','洗衣':'yushi','运动':'yundong','篮球':'yundong','操场':'yundong',
    '玩乐':'wanle','专业':'zhuanye','绩点':'jidian','学分':'jidian','奖学金':'jiangzhu',
    '助学金':'jiangzhu','图书馆':'lib','教学楼':'jiaoxue','教室':'jiaoxue','选课':'xuanke',
    '重修':'xuanke','补考':'xuanke','专升本':'zhuanben','证书':'zhengshu','教务':'jiaowu',
    '第二课堂':'dierketang','竞赛':'jingsai','科研':'jingsai','实习':'shixi','就业':'shixi',
    '电网':'shixi','党团':'dangtuan','评优':'pingyou','勤工':'qingong','技能':'jineng',
    '学习':'jineng','请假':'qingjia','医保':'yibao','报销':'yibao','报修':'baoxiu','学籍':'xueji',
    '休学':'xueji','转学':'xueji','财务':'caiwu','缴费':'caiwu','保卫':'baowei','门禁':'baowei',
    '资助':'zizhu','贷款':'zizhu','免训':'junxun','宽带':'sushe','热水':'sushe','接水':'yushi',
    '国网':'shixi','驾校':'jiuxiao','电话卡':'taocan','手机卡':'taocan','套餐':'taocan','移动':'taocan',
    '辅导':'zhusheng','升本辅导':'zhusheng','机构':'zhusheng','国网培训':'guowang','电网培训':'guowang',
    '兼职':'jianzhi','打工':'jianzhi','配送':'paotui','跑腿':'paotui','外卖':'paotui','代取':'paotui',
    '零食':'lingshi','小卖部':'lingshi','便利店':'lingshi'
  };
  var target = map[q];
  if (!target) {
    for (var k in map) { if (q.indexOf(k)>=0) {target=map[k];break;} }
  }
  if (target) {
    navigateToCard(target);
    var si = document.getElementById('searchInput'); if (si) si.value = '';
  } else {
    showToast('未找到相关内容，请换关键词试试');
  }
}

function liveFilter(query) {
  query = query.trim();
  var items = document.querySelectorAll('#cardsGrid .grid-item');
  items.forEach(function(item) {
    var label = item.querySelector('.grid-label');
    var tag = item.querySelector('.grid-tag');
    var text = ((label?label.textContent:'')+' '+(tag?tag.textContent:'')).toLowerCase();
    item.style.display = (!query||text.indexOf(query.toLowerCase())>=0) ? '' : 'none';
  });
}

function bindSearchInline() {
  var si = document.getElementById('searchInput');
  var sb = document.getElementById('searchBtn');
  if (si) si.addEventListener('input', function(){liveFilter(this.value);});
  if (sb) sb.addEventListener('click', function(){doSearch();});
  document.querySelectorAll('#stageExtra .search-hint').forEach(function(h){
    h.addEventListener('click', function(){doSearch(this.getAttribute('data-kw'));});
  });
  document.querySelectorAll('#catChips .cat-chip').forEach(function(c){
    c.addEventListener('click', function(){
      var cat = this.getAttribute('data-cat');
      currentCatFilter = (currentCatFilter===cat) ? null : cat;
      renderStageGrid();
      renderDailyExtra();
      bindSearchInline();
    });
  });
}

/* ============ EVENT BINDINGS ============ */
document.addEventListener('DOMContentLoaded', function(){
  updateStageUI();
  bindSearchInline();

  // Timeline
  document.querySelectorAll('.timeline-item').forEach(function(el){
    el.addEventListener('click', function(){
      var s = this.getAttribute('data-stage');
      if (s) setStage(s);
    });
  });

  // Modal
  contactModal.addEventListener('click', function(e){if(e.target===this) closeModal();});
  document.getElementById('modalCloseBtn').addEventListener('click', closeModal);
  document.getElementById('modalLaterBtn').addEventListener('click', closeModal);
  document.getElementById('copyWechatBtn').addEventListener('click', function(){copyText('XMB2D888');});
  document.getElementById('copyQQBtn').addEventListener('click', function(){copyText('3289094177');});

  // Detail
  document.getElementById('detailBackBtn').addEventListener('click', closeDetail);
  document.getElementById('detailPage').addEventListener('click', function(e){if(e.target===this) closeDetail();});

  // Grid delegation
  document.getElementById('cardsGrid').addEventListener('click', function(e){
    var item = e.target.closest('.grid-item');
    if (item) { var id = item.getAttribute('data-id'); if (id) openDetail(id); }
  });

  // Bottom nav
  document.getElementById('navHome').addEventListener('click', function(){
    closeDetail();setStage('departure');window.scrollTo({top:0,behavior:'smooth'});
    document.querySelectorAll('.nav-item').forEach(function(t){t.classList.remove('active');});
    this.classList.add('active');
  });
  document.getElementById('navSearch').addEventListener('click', function(){
    closeDetail();setStage('daily');document.querySelectorAll('.nav-item').forEach(function(t){t.classList.remove('active');});this.classList.add('active');
    setTimeout(function(){var si=document.getElementById('searchInput');if(si)si.focus();},400);
  });
  document.getElementById('navContact').addEventListener('click', function(){
    openModal();document.querySelectorAll('.nav-item').forEach(function(t){t.classList.remove('active');});
  });

  // Copy buttons in detail
  document.getElementById('detailBody').addEventListener('click', function(e){
    var btn = e.target.closest('[data-copy]');
    if (btn) copyText(btn.getAttribute('data-copy'));
  });

  // Keyboard
  document.addEventListener('keydown', function(e){
    if (e.key==='Escape' && document.getElementById('detailPage').classList.contains('active')) closeDetail();
  });
});
})();
</script>
</body>
</html>