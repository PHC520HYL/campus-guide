<button class="timeline-item" data-stage="term" aria-label="开学后"><span class="t-icon">📚</span>开学后</button>
<button class="timeline-item" data-stage="daily" aria-label="校园日常"><span class="t-icon">🎓</span>校园日常</button>
<button class="timeline-item" data-stage="deals" aria-label="校园特惠"><span class="t-icon">🛒</span>校园特惠</button>
</div>
</div>

<!-- ====== MAIN CONTENT ====== -->
